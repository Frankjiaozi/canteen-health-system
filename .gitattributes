# 统一换行符：仓库内一律 LF，避免 Windows/macOS/Linux 之间的无意义 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.xlsx binary

# Windows 批处理脚本必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 锁文件与生成物在 diff 中折叠
pnpm-lock.yaml linguist-generated=true
packages/api-client/src/schema.d.ts linguist-generated=true
