# 生产 / 内网自部署的编排变量。复制为 infra/.env 后按需修改。
# 该文件已被 .gitignore 忽略，不会进版本库。

# ---- 数据库 ----
POSTGRES_USER=canteen
# 必须改掉：这是唯一挡住数据被随意读取的东西
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=canteen

# ---- 后端 ----
# 必须改掉，且应当是足够长的随机串；改掉之后所有已登录会话都会失效
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# ---- 访问 ----
# 浏览器访问前端的端口
WEB_PORT=8080
# 若通过 HTTPS 访问（例如前置了 Caddy / Nginx + 证书），置为 true
COOKIE_SECURE=false

# ---- 自助注册 ----
# 内网正式部署保持 false：账号由管理员开通，不对外开放注册。
# 若只是拿这套容器做功能验证，可以改成 true。
ALLOW_OPEN_REGISTRATION=false

# ---- Agent（没有密钥时 auto 使用明确标注的规则模式）----
AGENT_MODE=auto
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_API_KEY=
AGENT_DATA_NOTICE=数据来源尚未核验，请先核对供餐台账、采购单价与营养来源。

# ---- 基础镜像（网络受限时改这里，不必改 Dockerfile）----
# 默认用 Docker 官方源。若所在网络访问不了 registry-1.docker.io，
# 把下面四项指到可用的 Docker Hub 镜像即可，例如：
#   POSTGRES_IMAGE=dockerproxy.net/library/postgres:17-alpine
#   PYTHON_IMAGE=dockerproxy.net/library/python:3.13-slim
#   NODE_IMAGE=dockerproxy.net/library/node:24-alpine
#   NGINX_IMAGE=dockerproxy.net/library/nginx:alpine
POSTGRES_IMAGE=postgres:17-alpine
PYTHON_IMAGE=python:3.13-slim
NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:alpine

# Python 包索引。网络访问 pypi.org 不稳定时，可改成可用的镜像，例如：
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple

# npm 源。构建前端时要用它下载 pnpm 与依赖；访问不了 registry.npmjs.org 时改成镜像，例如：
#   NPM_REGISTRY=https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

