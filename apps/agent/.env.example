# 独立 Agent；只通过 HTTP 使用业务服务，不配置 DATABASE_URL 或 JWT_SECRET。
AGENT_BUSINESS_API_URL=http://127.0.0.1:8000/api/v1
AGENT_COOKIE_NAME=canteen_token
AGENT_MODE=auto
# 未配置以下三项时，auto 进入明确标注的规则模式，仍使用真实业务计算。
# 选择支持 Chat Completions tools 的服务；示例不是供应商选择。
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_API_KEY=
# 数据落在服务自己的 SQLite；请备份，不和业务 PostgreSQL 共用。
AGENT_DATA_PATH=data/agent-state.sqlite3
# 初始化样本数据说明一直显示；获得真实数据后由负责人明确更新。
AGENT_DATA_NOTICE=当前环境数据来源尚未核实，仅用于功能验证，不代表真实食堂经营结果。
