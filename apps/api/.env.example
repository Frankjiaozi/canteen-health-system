# ===========================================================================
# 后端环境变量样例。复制为 .env 后按需修改；.env 已被 .gitignore 忽略。
# ===========================================================================

# ---- 应用 ----
APP_NAME=食堂健康管理系统
APP_ENV=development
DEBUG=true
# 全系统业务日期与时间戳统一使用该时区
APP_TIMEZONE=Asia/Shanghai

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg://canteen:canteen@127.0.0.1:5432/canteen
# 开发期打印 SQL，生产请置为 false
DB_ECHO=false

# ---- 认证 ----
# 生产环境必须替换为随机长字符串
JWT_SECRET=dev-only-secret-please-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
COOKIE_NAME=canteen_token
# 仅当通过 HTTPS 访问时置为 true
COOKIE_SECURE=false

# ---- 跨域 ----
# 开发期前端通过 Vite 代理访问后端，同源即可，通常留空数组
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
